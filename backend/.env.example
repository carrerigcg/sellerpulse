# Credenciais do projeto Supabase (Project Settings > API e > Database).
# Copiar para backend/.env e preencher — backend/.env é gitignored.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Banco Postgres local usado só pelos testes (backend/tests).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sellerpulse_test

# Sprint 2 — conexao com o Mercado Livre.
# TOKEN_ENCRYPTION_KEY e STATE_SECRET sao chaves Fernet, geradas com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use valores DIFERENTES pra cada uma (propositos diferentes), e a mesma
# TOKEN_ENCRYPTION_KEY aqui e no Render — perde-la obriga todo mundo a
# reconectar a conta do Mercado Livre.
TOKEN_ENCRYPTION_KEY=
STATE_SECRET=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://seu-backend.onrender.com/ml/callback
FRONTEND_URL=http://localhost:3000
DEMO_SELLER_ID=

# Regeneracao da demo publica. Vazio/ausente = LIGADO, que e o certo no Render:
# a cada boot, se a venda mais nova do seller de demonstracao estiver com mais
# de 7 dias, os dados sinteticos sao reescritos terminando em hoje.
#
# Ponha 0 no seu backend/.env local. O DEMO_SELLER_ID acima aponta pro seller
# de PRODUCAO, e a regeneracao APAGA os pedidos dele antes de re-semear --
# subir a API na sua maquina com isso ligado mexe na demo que esta no ar.
DEMO_REFRESH_IN_PROCESS=0
