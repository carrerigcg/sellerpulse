# Credenciais do projeto Supabase (Project Settings > API e > Database).
# Copiar para backend/.env e preencher — backend/.env é gitignored.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Banco Postgres local usado só pelos testes (backend/tests).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sellerpulse_test

# Sprint 2 — conexao com o Mercado Livre.
# TOKEN_ENCRYPTION_KEY e STATE_SECRET sao chaves Fernet, geradas com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use valores DIFERENTES pra cada uma (propositos diferentes), e a mesma
# TOKEN_ENCRYPTION_KEY aqui e no Render — perde-la obriga todo mundo a
# reconectar a conta do Mercado Livre.
TOKEN_ENCRYPTION_KEY=
STATE_SECRET=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://seu-backend.onrender.com/ml/callback
FRONTEND_URL=http://localhost:3000
DEMO_SELLER_ID=

# Regeneracao da demo publica. So LIGA com o valor exatamente 1 -- vazio,
# ausente ou qualquer outro valor = DESLIGADO. Ligado, a cada boot: se a venda
# mais nova do seller de demonstracao estiver com mais de 7 dias, os dados
# sinteticos sao reescritos terminando em hoje.
#
# O unico lugar que deve setar 1 e o host de PRODUCAO (Render, nas env vars do
# servico). Nao ligue no seu backend/.env local: o DEMO_SELLER_ID acima aponta
# pro seller de producao e a regeneracao APAGA os pedidos dele antes de
# re-semear -- subir a API na sua maquina com isso ligado mexe na demo que
# esta no ar. O default e desligado justamente porque esquecer de ligar custa
# uma demo velha, e esquecer de desligar custa dado apagado.
DEMO_REFRESH_IN_PROCESS=

# Segredo do agendador externo (GitHub Actions) que chama
# POST /ml/sync-todos uma vez por dia. Gere um valor aleatorio com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# O MESMO valor vai em dois lugares: nas env vars do servico no Render, e em
# Settings > Secrets and variables > Actions do repositorio, com o nome
# SYNC_SECRET.
#
# AUSENTE = endpoint DESLIGADO (responde 503), nunca aberto. Localmente pode
# ficar vazio: o endpoint so serve ao agendador.
SYNC_SECRET=
